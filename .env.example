# =============================================================================
# Crime Intelligence Platform — Environment Template
# Copy to .env and fill in values. Never commit .env.
# Production MUST use Catalyst services (see catalyst.txt / docs/deployment).
# =============================================================================

# --- App Core ---
APP_NAME=crime-intelligence-platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Persistence: postgres (local/CI) | catalyst (Data Store / mock) ---
PERSISTENCE_BACKEND=postgres

# --- Local Development Database (non-prod; mirrors Catalyst Data Store) ---
DATABASE_URL=postgresql+psycopg2://cip:cip_dev_password@localhost:5432/crime_intelligence
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Local Redis (non-prod; mirrors Catalyst Cache) ---
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Catalyst — Required for hackathon submission (see catalyst.txt)
# =============================================================================

# Project (ZAID = project_key for third-party SDK init)
# SDK setup: https://docs.catalyst.zoho.com/en/sdk/python/v1/setup/
#   pip install zcatalyst-sdk
# Inside Functions: CATALYST_INIT_MODE=function  (zcatalyst_sdk.initialize)
# Outside Catalyst: CATALYST_INIT_MODE=third_party + Self Client OAuth
#   https://docs.catalyst.zoho.com/en/sdk/python/v1/integrate-sdk-in-third-party-apps/
CATALYST_PROJECT_ID=
CATALYST_ZAID=
CATALYST_ENV=Development
CATALYST_ORG_ID=
CATALYST_PROJECT_DOMAIN=https://api.catalyst.zoho.com
CATALYST_INIT_MODE=auto
CATALYST_SDK_SCOPE=admin

# 1. Catalyst Functions (Serverless)
CATALYST_FUNCTION_NAME=
CATALYST_FUNCTION_ID=
CATALYST_FUNCTION_URL=

# 2–3. AppSail (OCI / managed runtime)
CATALYST_APPSAIL_APP_NAME=
CATALYST_APPSAIL_RUNTIME=
CATALYST_APPSAIL_URL=

# 4. Slate / Web Client Hosting
CATALYST_CLIENT_HOSTING_URL=
CATALYST_SLATE_PROJECT_ID=

# 5. Domain Mappings
CATALYST_DOMAIN=
CATALYST_DOMAIN_SSL_ENABLED=true

# 6. Data Store (relational) — set PERSISTENCE_BACKEND=catalyst to use for /cases
CATALYST_DATASTORE_TABLE_PREFIX=cip_
CATALYST_DATASTORE_ENDPOINT=
# Local JSON mock (no OAuth): PERSISTENCE_BACKEND=catalyst + CATALYST_DATASTORE_MOCK=true
CATALYST_DATASTORE_MOCK=false
CATALYST_DATASTORE_MOCK_PATH=.data/catalyst_datastore.json
# Table IDs from console (Data Store → click table → ID under name). Optional if names match.
CATALYST_TABLE_CASE_MASTER=
CATALYST_TABLE_VICTIM=
CATALYST_TABLE_ACCUSED=
CATALYST_TABLE_ACT_SECTION=

# 7. NoSQL
CATALYST_NOSQL_TABLE=
CATALYST_NOSQL_ENDPOINT=

# 8. Stratus (object / blob storage)
CATALYST_STRATUS_BUCKET=
CATALYST_STRATUS_ENDPOINT=
CATALYST_STRATUS_REGION=

# 9. Cache
CATALYST_CACHE_SEGMENT=
CATALYST_CACHE_ENDPOINT=

# 11–12. QuickML (LLM Serving, RAG, no-code ML)
CATALYST_QUICKML_ENDPOINT=
CATALYST_QUICKML_MODEL_ID=
CATALYST_RAG_KNOWLEDGE_BASE_ID=
CATALYST_RAG_ENDPOINT=

# 13. Zia AutoML
CATALYST_ZIA_AUTOML_ENDPOINT=
CATALYST_ZIA_AUTOML_MODEL_ID=

# 14–15. Zia Services (OCR, face, speech, translation, etc.)
CATALYST_ZIA_ENDPOINT=
CATALYST_ZIA_OCR_ENABLED=false
CATALYST_ZIA_SPEECH_ENABLED=false

# 16. SmartBrowz (PDF/report generation, headless browser)
CATALYST_SMARTBROWZ_ENDPOINT=
CATALYST_SMARTBROWZ_TEMPLATE_ID=

# 17. Authentication (Self Client refresh token for third-party SDK)
CATALYST_AUTH_DOMAIN=
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=
CATALYST_AUTH_REDIRECT_URI=

# 18. API Gateway
CATALYST_API_GATEWAY_URL=
CATALYST_API_KEY=

# 19. Connections (OAuth for Zoho / 3rd-party)
CATALYST_CONNECTIONS_SERVICE_NAME=

# 20. Cron / Job Scheduling
CATALYST_CRON_JOB_ID=
CATALYST_JOB_POOL_ID=

# 21–22. Signals (in-project events / event bus)
CATALYST_SIGNALS_TOPIC=
CATALYST_EVENT_FUNCTION_ID=

# 23. Circuits (workflow orchestration)
CATALYST_CIRCUITS_ID=
CATALYST_CIRCUITS_ENDPOINT=

# 24. Mail
CATALYST_MAIL_FROM=
CATALYST_MAIL_ENABLED=false

# 25. Push Notifications
CATALYST_PUSH_APP_ID=
CATALYST_PUSH_ENABLED=false

# 26. Pipelines (CI/CD)
CATALYST_PIPELINES_PROJECT_ID=
