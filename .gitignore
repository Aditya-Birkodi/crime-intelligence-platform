# =============================================================================
# Crime Intelligence Platform — .gitignore
# =============================================================================

# --- Secrets / env ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
credentials.json
secrets/
**/secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
.python-version

# Virtualenvs (keep out of git — local only)
.venv/
venv/
env/
ENV/
.virtualenv/

# Tooling / test caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/
.cache/
.pytype/
.dmypy.json
dmypy.json

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo
.npm
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Catalyst ---
.catalyst/
catalyst-config.json
.zcapp/
.data/
**/catalyst_datastore.json

# --- Logs ---
*.log
logs/*
!logs/.gitkeep
backend/logs/*
!backend/logs/.gitkeep

# --- OS ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
ehthumbs.db

# --- IDE / editors ---
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# --- Cursor ---
.cursor/
!.cursor/rules/
!.cursor/plans/

# --- Docker ---
docker-compose.override.yml
.dockerignore.local

# --- Misc ---
tmp/
temp/
*.tmp
*.bak
*.orig
*.swp
.DS_Store
openapi/openapi.local.json
